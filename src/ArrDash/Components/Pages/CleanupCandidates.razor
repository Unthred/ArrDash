@page "/cleanup"
@using ArrDash.Configuration
@using ArrDash.Models
@using ArrDash.Services
@using Microsoft.Extensions.Options
@inject CleanupCandidatesRepository Repository
@inject MediaInventorySyncService Sync
@inject LayoutPreferencesService Prefs
@inject MediaServiceOptionsAccessor ServiceOptions
@inject CleanupFeatureAvailability CleanupAvailability
@inject IOptions<CleanupCandidatesOptions> DefaultOptions
@inject ExternalLinkService Links

<PageTitle>Cleanup · ArrDash</PageTitle>

@if (!CleanupAvailability.IsAvailable)
{
    <div class="cleanup-page" style="max-width:720px;margin:0 auto">
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-4" Icon="@Icons.Material.Filled.CleaningServices">
            <MudText Typo="Typo.subtitle1" Class="mb-1">Cleanup needs Sonarr or Radarr</MudText>
            <MudText Typo="Typo.body2" Class="mb-3">
                This page builds candidates from your Sonarr/Radarr library plus watch history.
                Configure at least one of those services (URL + API key) in Settings, and leave it enabled.
            </MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/settings" StartIcon="@Icons.Material.Filled.Settings">
                Open Settings
            </MudButton>
        </MudAlert>
    </div>
}
else
{
<div class="cleanup-page">
    <div class="cleanup-chrome">
        <div class="d-flex align-center gap-4 mb-1 flex-wrap">
            <MudIcon Icon="@Icons.Material.Filled.CleaningServices" Color="Color.Primary" Size="Size.Large" />
            <MudText Typo="Typo.h4">Cleanup candidates</MudText>
            <MudSpacer />
            @if (_status.IsRunning)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Primary" />
            }
            <MudText Typo="Typo.caption" Class="muted">@StatusText</MudText>
            <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Refresh"
                       Disabled="_status.IsRunning" OnClick="RefreshNowAsync">
                Refresh
            </MudButton>
            <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Dashboard" Href="/">
                Dashboard
            </MudButton>
        </div>
        <MudText Typo="Typo.body2" Class="muted mb-3">
            Movies and TV largest, unwatched, or untouched in a while. Report only — nothing here deletes anything;
            click a title to open it in Radarr or Sonarr, or the IMDb icon to look it up.
            Mark items for deletion to build a planning queue with a reclaimable total; Tags are Sonarr/Radarr
            requester labels and are empty for most titles. Use Genre or Watched by to browse the library
            (including titles that are not cleanup candidates yet).
        </MudText>

        <MudPaper Class="pa-3 mb-3" Elevation="0" Outlined="true">
            <div class="d-flex align-center gap-2 flex-wrap">
                <MudText Typo="Typo.caption" Class="muted mr-2">View:</MudText>
                <MudChip T="string" Variant="@(_listView == ListView.Candidates ? Variant.Filled : Variant.Outlined)"
                         Color="@(_listView == ListView.Candidates ? Color.Primary : Color.Default)"
                         Icon="@Icons.Material.Filled.CleaningServices"
                         OnClick="@(() => SetListView(ListView.Candidates))">
                    Candidates
                </MudChip>
                <MudChip T="string" Class="cleanup-queue-chip"
                         Variant="@(_listView == ListView.DeletionQueue ? Variant.Filled : Variant.Outlined)"
                         Color="@(_listView == ListView.DeletionQueue ? Color.Error : Color.Default)"
                         Icon="@Icons.Material.Filled.DeleteSweep"
                         OnClick="@(() => SetListView(ListView.DeletionQueue))">
                    Deletion queue (@MarkedCount)
                </MudChip>
                <MudText Typo="Typo.caption" Class="muted ml-2 mr-1">Layout:</MudText>
                <MudChip T="string" Variant="@(_displayMode == CleanupDisplayMode.Compact ? Variant.Filled : Variant.Outlined)"
                         Color="@(_displayMode == CleanupDisplayMode.Compact ? Color.Primary : Color.Default)"
                         OnClick="@(() => SetDisplayModeAsync(CleanupDisplayMode.Compact))">
                    Compact
                </MudChip>
                <MudChip T="string" Variant="@(_displayMode == CleanupDisplayMode.Posters ? Variant.Filled : Variant.Outlined)"
                         Color="@(_displayMode == CleanupDisplayMode.Posters ? Color.Primary : Color.Default)"
                         OnClick="@(() => SetDisplayModeAsync(CleanupDisplayMode.Posters))">
                    Posters
                </MudChip>
                <MudSpacer />
                <div class="cleanup-filter-slot">
                    <MudSelect T="string"
                               MultiSelection="true"
                               SelectedValues="_selectedGenres"
                               SelectedValuesChanged="OnGenresChanged"
                               Label="Genre"
                               Placeholder="Any genre"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Dense="true"
                               Clearable="true"
                               FullWidth="true"
                               MultiSelectionTextFunc="@FormatGenreSelection"
                               Class="cleanup-genre-select">
                        @foreach (var genre in _availableGenres)
                        {
                            <MudSelectItem T="string" Value="@genre">@genre</MudSelectItem>
                        }
                    </MudSelect>
                </div>
                <div class="cleanup-filter-slot">
                    <MudSelect T="string"
                               MultiSelection="true"
                               SelectedValues="_selectedWatchers"
                               SelectedValuesChanged="OnWatchersChanged"
                               Label="Watched by"
                               Placeholder="Any user"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Dense="true"
                               Clearable="true"
                               FullWidth="true"
                               MultiSelectionTextFunc="@FormatWatcherSelection"
                               Class="cleanup-watcher-select">
                        @foreach (var user in _availableWatchers)
                        {
                            <MudSelectItem T="string" Value="@user">@user</MudSelectItem>
                        }
                    </MudSelect>
                </div>
                <div class="cleanup-filter-slot">
                    <MudTextField @bind-Value="_searchText"
                                  @bind-Value:after="OnSearchChanged"
                                  Immediate="true"
                                  DebounceInterval="200"
                                  Placeholder="Search library by title, genres, tags, watchers…"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  Clearable="true"
                                  FullWidth="true"
                                  Class="cleanup-search-field" />
                </div>
            </div>
        </MudPaper>

        @if (!_loading)
        {
            <MudGrid Class="mb-3 cleanup-stats" Spacing="2">
                <MudItem xs="6" sm="3">
                    <MudPaper Class="pa-3 stat-card" Elevation="1">
                        <MudText Typo="Typo.caption" Class="muted cleanup-stat-caption">Shown</MudText>
                        <MudText Typo="Typo.h5" Class="cleanup-stat-value">@_filteredCount</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="6" sm="3">
                    <MudPaper Class="pa-3 stat-card" Elevation="1">
                        <MudText Typo="Typo.caption" Class="muted cleanup-stat-caption">@(_listView == ListView.DeletionQueue ? "Would free" : "Reclaimable")</MudText>
                        <MudText Typo="Typo.h5" Class="cleanup-stat-value">@ByteDisplayHelper.Format(_filteredBytes)</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="6" sm="3">
                    <MudPaper Class="pa-3 stat-card" Elevation="1">
                        <MudText Typo="Typo.caption" Class="muted cleanup-stat-caption">Movies</MudText>
                        <MudText Typo="Typo.h5" Class="cleanup-stat-value">@_filteredMovies</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="6" sm="3">
                    <MudPaper Class="pa-3 stat-card" Elevation="1">
                        <MudText Typo="Typo.caption" Class="muted cleanup-stat-caption">Series</MudText>
                        <MudText Typo="Typo.h5" Class="cleanup-stat-value">@_filteredSeries</MudText>
                    </MudPaper>
                </MudItem>
            </MudGrid>
        }

        @if (_listView == ListView.Candidates)
        {
            <MudPaper Class="pa-3 mb-3" Elevation="0" Outlined="true">
                <div class="d-flex align-center gap-2 mb-2 flex-wrap">
                    <MudText Typo="Typo.caption" Class="muted mr-2">Show:</MudText>
                    <MudChip T="string" Variant="@(_mediaTypeFilter == MediaTypeFilter.All ? Variant.Filled : Variant.Outlined)"
                             Color="@(_mediaTypeFilter == MediaTypeFilter.All ? Color.Primary : Color.Default)"
                             Icon="@Icons.Material.Filled.SelectAll"
                             OnClick="@(() => SetMediaTypeFilter(MediaTypeFilter.All))">
                        All
                    </MudChip>
                    <MudChip T="string" Variant="@(_mediaTypeFilter == MediaTypeFilter.Movie ? Variant.Filled : Variant.Outlined)"
                             Color="@(_mediaTypeFilter == MediaTypeFilter.Movie ? Color.Primary : Color.Default)"
                             Icon="@Icons.Material.Filled.Movie"
                             OnClick="@(() => SetMediaTypeFilter(MediaTypeFilter.Movie))">
                        Movies
                    </MudChip>
                    <MudChip T="string" Variant="@(_mediaTypeFilter == MediaTypeFilter.Series ? Variant.Filled : Variant.Outlined)"
                             Color="@(_mediaTypeFilter == MediaTypeFilter.Series ? Color.Primary : Color.Default)"
                             Icon="@Icons.Material.Filled.LiveTv"
                             OnClick="@(() => SetMediaTypeFilter(MediaTypeFilter.Series))">
                        TV
                    </MudChip>
                    <MudSpacer />
                    <MudSwitch T="bool" Value="_showKept" ValueChanged="OnShowKeptChanged" Color="Color.Success" Label="Show kept items" />
                    <MudNumericField T="int" Value="_thresholdMonths" ValueChanged="OnThresholdChanged"
                                      Label="Stale threshold (months)" Variant="Variant.Outlined" Min="1" Max="60"
                                      Style="max-width:200px" Margin="Margin.Dense" />
                </div>

                <div class="d-flex align-center gap-2 flex-wrap">
                    <MudText Typo="Typo.caption" Class="muted mr-2">Reason:</MudText>
                    <MudChip T="string" Variant="@(_activeFilters.Contains(CleanupReason.NeverWatched) ? Variant.Filled : Variant.Outlined)"
                             Color="@(_activeFilters.Contains(CleanupReason.NeverWatched) ? Color.Info : Color.Default)"
                             OnClick="@(() => ToggleFilter(CleanupReason.NeverWatched))">
                        Never watched
                    </MudChip>
                    <MudChip T="string" Variant="@(_activeFilters.Contains(CleanupReason.WatchedLongAgo) ? Variant.Filled : Variant.Outlined)"
                             Color="@(_activeFilters.Contains(CleanupReason.WatchedLongAgo) ? Color.Warning : Color.Default)"
                             OnClick="@(() => ToggleFilter(CleanupReason.WatchedLongAgo))">
                        Watched long ago
                    </MudChip>
                    <MudChip T="string" Variant="@(_activeFilters.Contains(CleanupReason.Largest) ? Variant.Filled : Variant.Outlined)"
                             Color="@(_activeFilters.Contains(CleanupReason.Largest) ? Color.Error : Color.Default)"
                             OnClick="@(() => ToggleFilter(CleanupReason.Largest))">
                        Largest
                    </MudChip>
                </div>
            </MudPaper>
        }
        else
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mb-3" Dense="true">
                Planning list only — ArrDash does not delete files. Open each title in Sonarr/Radarr to remove it yourself,
                then unmark it here. Would free: @ByteDisplayHelper.Format(_candidates.Where(c => c.MarkedForDeletion).Sum(c => c.SizeBytes)).
            </MudAlert>
        }
    </div>

    <div class="cleanup-table-region">
    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" />
    }
    else if (_filteredCount == 0)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
            @(_listView == ListView.DeletionQueue
                ? (IsBrowsingLibrary
                    ? "No marked items match the current search or users."
                    : "Nothing marked for deletion yet. Use the trash icon on a candidate to add it here.")
                : (IsBrowsingLibrary
                    ? "No titles match the search, users, or filters."
                    : "No cleanup candidates match the current filters."))
        </MudAlert>
    }
    else
    {
        <TableScrollShell Class="cleanup-table-fill">
            <MudPaper Elevation="1" Class="cleanup-table-shell">
            <MudTable Items="FilteredCandidates" Hover="true" Dense="true" Striped="true" SortLabel="Sort by"
                      AllowUnsorted="false"
                      @bind-RowsPerPage="_rowsPerPage"
                      @bind-CurrentPage="_tablePage"
                      Class="@(_displayMode == CleanupDisplayMode.Posters ? "cleanup-table--posters" : "cleanup-table--compact")"
                      RowClassFunc="@RowClassFor">
                <HeaderContent>
                    <MudTh Style="width:48px"><MudTableSortLabel SortBy="SortByNeverDelete">Keep</MudTableSortLabel></MudTh>
                    <MudTh Style="width:48px"><MudTableSortLabel SortBy="SortByMarkedForDeletion">Delete</MudTableSortLabel></MudTh>
                    @if (_displayMode == CleanupDisplayMode.Posters)
                    {
                        <MudTh Style="width:48px">Art</MudTh>
                    }
                    <MudTh><MudTableSortLabel SortBy="SortByTitle">Title</MudTableSortLabel></MudTh>
                    <MudTh Style="width:56px"><MudTableSortLabel SortBy="SortByMediaType">Type</MudTableSortLabel></MudTh>
                    <MudTh Style="width:72px"><MudTableSortLabel SortBy="SortByRating">Rating</MudTableSortLabel></MudTh>
                    <MudTh Style="width:88px"><MudTableSortLabel SortBy="SortBySizeBytes" InitialDirection="SortDirection.Descending">Size</MudTableSortLabel></MudTh>
                    <MudTh Style="width:100px"><MudTableSortLabel SortBy="SortByReleasedUtc">Released</MudTableSortLabel></MudTh>
                    <MudTh Style="width:100px"><MudTableSortLabel SortBy="SortByAddedUtc">Added</MudTableSortLabel></MudTh>
                    <MudTh Style="width:100px"><MudTableSortLabel SortBy="SortByLastWatchedUtc">Last watched</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortBy="SortByWatchedByCount">Watched by</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortBy="SortByTagsCount">Tags</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortBy="SortByReasonsCount">Reasons</MudTableSortLabel></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Keep">
                        <MudTooltip Text="@(context.NeverDelete ? "Marked never delete — click to unmark" : "Mark as never delete")">
                            <MudIconButton Size="Size.Small"
                                           Icon="@(context.NeverDelete ? Icons.Material.Filled.Bookmark : Icons.Material.Outlined.BookmarkBorder)"
                                           Color="@(context.NeverDelete ? Color.Warning : Color.Default)"
                                           Disabled="@(context.MarkedForDeletion)"
                                           OnClick="@(() => ToggleKeepAsync(context))" />
                        </MudTooltip>
                    </MudTd>
                    <MudTd DataLabel="Delete">
                        <MudTooltip Text="@(context.MarkedForDeletion ? "Remove from deletion queue" : "Add to deletion queue")">
                            <MudIconButton Size="Size.Small"
                                           Icon="@(context.MarkedForDeletion ? Icons.Material.Filled.Delete : Icons.Material.Outlined.DeleteOutline)"
                                           Color="@(context.MarkedForDeletion ? Color.Error : Color.Default)"
                                           Disabled="@(context.NeverDelete)"
                                           OnClick="@(() => ToggleDeleteMarkAsync(context))" />
                        </MudTooltip>
                    </MudTd>
                    @if (_displayMode == CleanupDisplayMode.Posters)
                    {
                        <MudTd DataLabel="Art" Class="cleanup-poster-cell">
                            <div class="cleanup-row-poster-slot">
                            @if (PosterUrl(context) is { } poster)
                            {
                                <img class="cleanup-row-poster" src="@poster" alt="" loading="lazy" decoding="async" width="32" height="48" />
                            }
                            </div>
                        </MudTd>
                    }
                    <MudTd DataLabel="Title">
                        <div class="d-flex align-center gap-1">
                            @RenderLinkedTitle(context)
                            @if (!string.IsNullOrWhiteSpace(context.ImdbId))
                            {
                                <MudTooltip Text="Look up on IMDb">
                                    <a href="@($"https://www.imdb.com/title/{context.ImdbId}/")" target="_blank" rel="noopener noreferrer" class="d-flex align-center">
                                        <MudIcon Icon="@Icons.Material.Filled.OpenInNew" Size="Size.Small" Color="Color.Default" />
                                    </a>
                                </MudTooltip>
                            }
                        </div>
                    </MudTd>
                    <MudTd DataLabel="Type">
                        <div class="d-flex align-center gap-1">
                            <MudTooltip Text="@(context.MediaType == "movie" ? "Movie" : "Series")">
                                <MudIcon Icon="@(context.MediaType == "movie" ? Icons.Material.Filled.Movie : Icons.Material.Filled.LiveTv)" Size="Size.Small" />
                            </MudTooltip>
                            @if (context.MediaType == "series" && !string.IsNullOrWhiteSpace(context.SeriesStatus))
                            {
                                <MudTooltip Text="@SeriesStatusLabel(context.SeriesStatus)">
                                    <MudIcon Icon="@SeriesStatusIcon(context.SeriesStatus)"
                                             Size="Size.Small"
                                             Color="@SeriesStatusColor(context.SeriesStatus)" />
                                </MudTooltip>
                            }
                        </div>
                    </MudTd>
                    <MudTd DataLabel="Rating">
                        @if (context.Rating is { } rating)
                        {
                            <div class="d-flex align-center gap-1">
                                <MudIcon Icon="@Icons.Material.Filled.Star" Size="Size.Small" Color="@RatingColor(rating)" />
                                <MudText Typo="Typo.body2">@rating.ToString("0.0")</MudText>
                            </div>
                        }
                        else
                        {
                            <MudText Typo="Typo.body2" Class="muted">—</MudText>
                        }
                    </MudTd>
                    <MudTd DataLabel="Size">@ByteDisplayHelper.Format(context.SizeBytes)</MudTd>
                    <MudTd DataLabel="Released">@(context.ReleasedUtc is { } rel ? rel.ToLocalTime().ToString("dd MMM yyyy") : "—")</MudTd>
                    <MudTd DataLabel="Added">@(context.AddedUtc is { } a ? a.ToLocalTime().ToString("dd MMM yyyy") : "—")</MudTd>
                    <MudTd DataLabel="Last watched">@(context.LastWatchedUtc is { } w ? w.ToLocalTime().ToString("dd MMM yyyy") : "Never")</MudTd>
                    <MudTd DataLabel="Watched by">
                        @if (context.WatchedBy.Count == 0)
                        {
                            <MudText Typo="Typo.body2" Class="muted">—</MudText>
                        }
                        else
                        {
                            <MudTooltip Text="@string.Join(", ", context.WatchedBy)">
                                <div class="cleanup-chip-row cleanup-chip-row--clamp">
                                    <MudText Typo="Typo.caption">@string.Join(", ", context.WatchedBy)</MudText>
                                </div>
                            </MudTooltip>
                        }
                    </MudTd>
                    <MudTd DataLabel="Tags">
                        @if (context.Tags.Count == 0)
                        {
                            <MudText Typo="Typo.body2" Class="muted">—</MudText>
                        }
                        else
                        {
                            <MudTooltip Text="@string.Join(", ", context.Tags)">
                                <div class="cleanup-chip-row cleanup-chip-row--clamp">
                                    <MudText Typo="Typo.caption">@string.Join(", ", context.Tags)</MudText>
                                </div>
                            </MudTooltip>
                        }
                    </MudTd>
                    <MudTd DataLabel="Reasons">
                        <div class="cleanup-chip-row cleanup-chip-row--clamp">
                        @if (context.NeverDelete)
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="Color.Success" Icon="@Icons.Material.Filled.Bookmark" Class="mr-1">Kept</MudChip>
                        }
                        @foreach (var reason in context.Reasons)
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@ReasonColor(reason)" Class="mr-1">@ReasonLabel(reason)</MudChip>
                        }
                        @if (context.Reasons.Count == 0 && context.MarkedForDeletion)
                        {
                            <MudText Typo="Typo.caption" Class="muted">No longer a candidate</MudText>
                        }
                        else if (context.Reasons.Count == 0 && !context.NeverDelete)
                        {
                            <MudTooltip Text="In your library but not flagged yet (too recent / still watched / not in the largest set). Shown because it matches your search.">
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default" Class="mr-1">Not a candidate</MudChip>
                            </MudTooltip>
                        }
                        </div>
                    </MudTd>
                </RowTemplate>
                <PagerContent>
                    <MudTablePager PageSizeOptions="new int[] { 25, 50, 100, 200 }" />
                </PagerContent>
            </MudTable>
            </MudPaper>
        </TableScrollShell>
    }
    </div>
</div>
}

@code {
    private enum MediaTypeFilter { All, Movie, Series }
    private enum ListView { Candidates, DeletionQueue }

    private static readonly Func<CleanupCandidateItem, object> SortByNeverDelete = x => x.NeverDelete;
    private static readonly Func<CleanupCandidateItem, object> SortByMarkedForDeletion = x => x.MarkedForDeletion;
    private static readonly Func<CleanupCandidateItem, object> SortByTitle = x => x.Title;
    private static readonly Func<CleanupCandidateItem, object> SortByMediaType = x => x.MediaType;
    private static readonly Func<CleanupCandidateItem, object> SortByRating = x => (object?)x.Rating ?? -1d;
    private static readonly Func<CleanupCandidateItem, object> SortBySizeBytes = x => x.SizeBytes;
    private static readonly Func<CleanupCandidateItem, object> SortByReleasedUtc = x => (object?)x.ReleasedUtc ?? DateTimeOffset.MinValue;
    private static readonly Func<CleanupCandidateItem, object> SortByAddedUtc = x => (object?)x.AddedUtc ?? DateTimeOffset.MinValue;
    private static readonly Func<CleanupCandidateItem, object> SortByLastWatchedUtc = x => (object?)x.LastWatchedUtc ?? DateTimeOffset.MinValue;
    private static readonly Func<CleanupCandidateItem, object> SortByWatchedByCount = x => x.WatchedBy.Count;
    private static readonly Func<CleanupCandidateItem, object> SortByTagsCount = x => x.Tags.Count;
    private static readonly Func<CleanupCandidateItem, object> SortByReasonsCount = x => x.Reasons.Count;

    private List<CleanupCandidateItem> _candidates = [];
    private IReadOnlyList<CleanupCandidateItem> _filtered = [];
    private IReadOnlyList<string> _availableWatchers = [];
    private IReadOnlyList<string> _availableGenres = [];
    private IEnumerable<string> _selectedWatchers = Array.Empty<string>();
    private IEnumerable<string> _selectedGenres = Array.Empty<string>();
    private int _markedCount;
    private int _filteredCount;
    private long _filteredBytes;
    private int _filteredMovies;
    private int _filteredSeries;
    private readonly HashSet<CleanupReason> _activeFilters = new();
    private MediaTypeFilter _mediaTypeFilter = MediaTypeFilter.All;
    private ListView _listView = ListView.Candidates;
    private CleanupDisplayMode _displayMode = CleanupDisplayMode.Compact;
    private string _searchText = "";
    private bool _showKept;
    private int _thresholdMonths;
    private bool _loading = true;
    private MediaInventorySyncStatus _status = new(false, "", null);
    private int _tablePage;
    private int _rowsPerPage = 50;

    private int MarkedCount => _markedCount;
    private IReadOnlyList<CleanupCandidateItem> FilteredCandidates => _filtered;
    private bool HasSearch => !string.IsNullOrWhiteSpace(_searchText);
    private bool HasWatcherFilter => _selectedWatchers.Any();
    private bool HasGenreFilter => _selectedGenres.Any();
    private bool IsBrowsingLibrary => HasSearch || HasWatcherFilter || HasGenreFilter;

    private string StatusText =>
        _status.IsRunning
            ? _status.CurrentMessage
            : _status.LastSyncAt is { } last
                ? $"Last synced {TimeDisplayHelper.FormatRelative(last)}"
                : "Not yet synced";

    protected override async Task OnInitializedAsync()
    {
        if (!CleanupAvailability.IsAvailable)
            return;

        _thresholdMonths = Prefs.Current.CleanupCandidatesStaleThresholdMonths > 0
            ? Prefs.Current.CleanupCandidatesStaleThresholdMonths
            : DefaultOptions.Value.StaleThresholdMonths;
        _displayMode = Prefs.Current.CleanupDisplayMode == CleanupDisplayMode.Posters
            ? CleanupDisplayMode.Posters
            : CleanupDisplayMode.Compact;
        if (Prefs.Current.CleanupDisplayMode != _displayMode)
            await Prefs.UpdateAsync(p => p.CleanupDisplayMode = _displayMode);
        _status = Sync.CurrentStatus;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        StateHasChanged();

        var aliases = Prefs.Current.UserAliases;
        var inventory = await Repository.GetInventoryAsync(CancellationToken.None);
        var movieLastPlayed = await Repository.GetMovieLastPlayedAsync(CancellationToken.None);
        var seriesLastPlayed = await Repository.GetSeriesLastPlayedAsync(CancellationToken.None);
        var movieWatchers = await Repository.GetMovieWatchersAsync(aliases, CancellationToken.None);
        var seriesWatchers = await Repository.GetSeriesWatchersAsync(aliases, CancellationToken.None);
        var tagLabels = await Repository.GetTagLabelsAsync(CancellationToken.None);

        _candidates = CleanupCandidateAnalysisService.Build(
            inventory,
            movieLastPlayed,
            seriesLastPlayed,
            movieWatchers,
            seriesWatchers,
            tagLabels,
            _thresholdMonths,
            ServiceOptions.Options.Radarr.Url,
            ServiceOptions.Options.Sonarr.Url).ToList();

        _availableWatchers = _candidates
            .SelectMany(c => c.WatchedBy)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(n => n, StringComparer.OrdinalIgnoreCase)
            .ToList();

        _availableGenres = _candidates
            .SelectMany(c => c.Genres)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(n => n, StringComparer.OrdinalIgnoreCase)
            .ToList();

        // Drop selections that disappeared after a refresh.
        if (HasWatcherFilter)
        {
            var stillValid = new HashSet<string>(_availableWatchers, StringComparer.OrdinalIgnoreCase);
            _selectedWatchers = _selectedWatchers.Where(stillValid.Contains).ToHashSet(StringComparer.OrdinalIgnoreCase);
        }

        if (HasGenreFilter)
        {
            var stillValid = new HashSet<string>(_availableGenres, StringComparer.OrdinalIgnoreCase);
            _selectedGenres = _selectedGenres.Where(stillValid.Contains).ToHashSet(StringComparer.OrdinalIgnoreCase);
        }

        RebuildFiltered(resetPage: true);
        _loading = false;
        StateHasChanged();
    }

    private void RebuildFiltered(bool resetPage = false)
    {
        _markedCount = 0;
        foreach (var c in _candidates)
        {
            if (c.MarkedForDeletion)
                _markedCount++;
        }

        if (_listView == ListView.DeletionQueue)
        {
            _filtered = ApplyBrowseFilters(_candidates.Where(c => c.MarkedForDeletion)).ToList();
            CacheFilteredStats();
            if (resetPage)
                _tablePage = 0;
            return;
        }

        IEnumerable<CleanupCandidateItem> query = _candidates.Where(c => !c.MarkedForDeletion);

        if (!_showKept)
            query = query.Where(c => !c.NeverDelete);

        // Without search/user filters, only show real cleanup flags (or Keep bookmarks).
        // With those, also surface matching library titles that are not candidates yet.
        if (!IsBrowsingLibrary)
            query = query.Where(c => c.Reasons.Count > 0 || c.NeverDelete);

        query = _mediaTypeFilter switch
        {
            MediaTypeFilter.Movie => query.Where(c => c.MediaType == "movie"),
            MediaTypeFilter.Series => query.Where(c => c.MediaType == "series"),
            _ => query
        };

        if (_activeFilters.Count > 0)
            query = query.Where(c => c.Reasons.Any(_activeFilters.Contains));

        _filtered = ApplyBrowseFilters(query).ToList();
        CacheFilteredStats();
        if (resetPage)
            _tablePage = 0;
    }

    private void CacheFilteredStats()
    {
        var count = 0;
        long bytes = 0;
        var movies = 0;
        var series = 0;
        foreach (var c in _filtered)
        {
            count++;
            bytes += c.SizeBytes;
            if (c.MediaType == "movie")
                movies++;
            else if (c.MediaType == "series")
                series++;
        }

        _filteredCount = count;
        _filteredBytes = bytes;
        _filteredMovies = movies;
        _filteredSeries = series;
    }

    private IEnumerable<CleanupCandidateItem> ApplyBrowseFilters(IEnumerable<CleanupCandidateItem> query)
    {
        if (HasWatcherFilter)
        {
            var selected = _selectedWatchers as HashSet<string>
                ?? _selectedWatchers.ToHashSet(StringComparer.OrdinalIgnoreCase);
            query = query.Where(c => c.WatchedBy.Any(selected.Contains));
        }

        if (HasGenreFilter)
        {
            var selected = _selectedGenres as HashSet<string>
                ?? _selectedGenres.ToHashSet(StringComparer.OrdinalIgnoreCase);
            query = query.Where(c => c.Genres.Any(selected.Contains));
        }

        var search = _searchText.Trim();
        if (search.Length == 0)
            return query;

        return query.Where(c => MatchesSearch(c, search));
    }

    private static bool MatchesSearch(CleanupCandidateItem item, string search)
    {
        if (item.Title.Contains(search, StringComparison.OrdinalIgnoreCase))
            return true;

        if (item.Year is { } year && year.ToString().Contains(search, StringComparison.OrdinalIgnoreCase))
            return true;

        if (item.ImdbId is { } imdb && imdb.Contains(search, StringComparison.OrdinalIgnoreCase))
            return true;

        foreach (var tag in item.Tags)
        {
            if (tag.Contains(search, StringComparison.OrdinalIgnoreCase))
                return true;
        }

        foreach (var genre in item.Genres)
        {
            if (genre.Contains(search, StringComparison.OrdinalIgnoreCase))
                return true;
        }

        foreach (var watcher in item.WatchedBy)
        {
            if (watcher.Contains(search, StringComparison.OrdinalIgnoreCase))
                return true;
        }

        return false;
    }

    private void OnSearchChanged() => RebuildFiltered(resetPage: true);

    private void OnWatchersChanged(IEnumerable<string> values)
    {
        _selectedWatchers = values?.ToHashSet(StringComparer.OrdinalIgnoreCase)
            ?? new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        RebuildFiltered(resetPage: true);
    }

    private void OnGenresChanged(IEnumerable<string> values)
    {
        _selectedGenres = values?.ToHashSet(StringComparer.OrdinalIgnoreCase)
            ?? new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        RebuildFiltered(resetPage: true);
    }

    private static string FormatWatcherSelection(List<string> selected) =>
        FormatMultiSelection(selected, "Any user", "users");

    private static string FormatGenreSelection(List<string> selected) =>
        FormatMultiSelection(selected, "Any genre", "genres");

    private static string FormatMultiSelection(List<string> selected, string emptyLabel, string pluralNoun)
    {
        if (selected.Count == 0)
            return emptyLabel;
        if (selected.Count == 1)
            return selected[0];
        return $"{selected.Count} {pluralNoun}";
    }

    private async Task OnThresholdChanged(int value)
    {
        _thresholdMonths = Math.Clamp(value, 1, 60);
        await LoadAsync();
    }

    private void SetMediaTypeFilter(MediaTypeFilter filter)
    {
        _mediaTypeFilter = filter;
        RebuildFiltered(resetPage: true);
    }

    private void SetListView(ListView view)
    {
        _listView = view;
        RebuildFiltered(resetPage: true);
    }

    private void OnShowKeptChanged(bool value)
    {
        _showKept = value;
        RebuildFiltered(resetPage: true);
    }

    private void ToggleFilter(CleanupReason reason)
    {
        if (!_activeFilters.Remove(reason))
            _activeFilters.Add(reason);
        RebuildFiltered(resetPage: true);
    }

    private async Task RefreshNowAsync()
    {
        await Sync.SyncAsync(CancellationToken.None);
        _status = Sync.CurrentStatus;
        await LoadAsync();
    }

    private async Task ToggleKeepAsync(CleanupCandidateItem item)
    {
        var next = !item.NeverDelete;
        var previous = item;
        ApplyLocalUpdate(item with { NeverDelete = next, MarkedForDeletion = next ? false : item.MarkedForDeletion });
        try
        {
            await Repository.SetNeverDeleteAsync(item.Source, item.SourceItemId, next, CancellationToken.None);
        }
        catch
        {
            ApplyLocalUpdate(previous);
        }
    }

    private async Task ToggleDeleteMarkAsync(CleanupCandidateItem item)
    {
        var next = !item.MarkedForDeletion;
        var previous = item;
        ApplyLocalUpdate(item with { MarkedForDeletion = next, NeverDelete = next ? false : item.NeverDelete });
        try
        {
            await Repository.SetMarkedForDeletionAsync(item.Source, item.SourceItemId, next, CancellationToken.None);
        }
        catch
        {
            ApplyLocalUpdate(previous);
        }
    }

    private void ApplyLocalUpdate(CleanupCandidateItem updated)
    {
        var index = _candidates.FindIndex(c => c.Source == updated.Source && c.SourceItemId == updated.SourceItemId);
        if (index < 0)
            return;

        _candidates[index] = updated;
        RebuildFiltered();
    }

    private static string ReasonLabel(CleanupReason reason) => reason switch
    {
        CleanupReason.NeverWatched => "Never watched",
        CleanupReason.WatchedLongAgo => "Watched long ago",
        CleanupReason.Largest => "Largest",
        _ => reason.ToString()
    };

    private static string SeriesStatusLabel(string? status) => status?.ToLowerInvariant() switch
    {
        "ended" => "Ended",
        "continuing" => "Continuing",
        "upcoming" => "Upcoming",
        "deleted" => "Deleted from TVDB",
        _ => string.IsNullOrWhiteSpace(status) ? "Unknown" : status
    };

    private static string SeriesStatusIcon(string? status) => status?.ToLowerInvariant() switch
    {
        "ended" => Icons.Material.Filled.Flag,
        "continuing" => Icons.Material.Filled.PlayCircle,
        "upcoming" => Icons.Material.Filled.Event,
        "deleted" => Icons.Material.Filled.Cancel,
        _ => Icons.Material.Filled.HelpOutline
    };

    private static Color SeriesStatusColor(string? status) => status?.ToLowerInvariant() switch
    {
        "ended" => Color.Success,
        "continuing" => Color.Info,
        "upcoming" => Color.Warning,
        "deleted" => Color.Error,
        _ => Color.Default
    };

    private static Color RatingColor(double rating) => rating switch
    {
        >= 7 => Color.Success,
        >= 5 => Color.Warning,
        _ => Color.Error
    };

    private static Color ReasonColor(CleanupReason reason) => reason switch
    {
        CleanupReason.NeverWatched => Color.Info,
        CleanupReason.WatchedLongAgo => Color.Warning,
        CleanupReason.Largest => Color.Error,
        _ => Color.Default
    };

    private string RowClassFor(CleanupCandidateItem item, int index) =>
        item.NeverDelete ? "cleanup-row--kept" : item.MarkedForDeletion ? "cleanup-row--delete" : "";

    private static string? PosterUrl(CleanupCandidateItem item) => item.Source switch
    {
        "radarr" => $"/api/poster/radarr/{item.SourceItemId}",
        "sonarr" => $"/api/poster/sonarr/{item.SourceItemId}",
        _ => null
    };

    private async Task SetDisplayModeAsync(CleanupDisplayMode mode)
    {
        if (_displayMode == mode)
            return;
        _displayMode = mode;
        await Prefs.UpdateAsync(p => p.CleanupDisplayMode = mode);
    }

    private RenderFragment RenderLinkedTitle(CleanupCandidateItem item) => builder =>
    {
        if (item.ExternalUrl is not null)
        {
            builder.OpenElement(0, "a");
            builder.AddAttribute(1, "href", item.ExternalUrl);
            builder.AddAttribute(2, "target", ExternalLinkService.TargetAttribute(Prefs.Current.ExternalLinkTarget));
            builder.AddAttribute(3, "rel", "noopener noreferrer");
        }
        else
        {
            builder.OpenElement(0, "span");
        }

        var label = item.Year is { } year ? $"{item.Title} ({year})" : item.Title;
        builder.AddContent(4, label);
        builder.CloseElement();
    };
}
